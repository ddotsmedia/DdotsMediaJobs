# ─────────────────────────────────────────────
# Ddotsmedia Jobs — Production Environment
# Copy this file to .env and fill in all values
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────
# These are used by docker-compose.prod.yml to build the connection string
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=uaejobs

# ── Redis ─────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ── App ───────────────────────────────────────
NODE_ENV=production
PORT=4000

# Your public domain (no trailing slash)
# Used by the API for CORS and by Vite build for the frontend API client
FRONTEND_URL=https://yourdomain.com
API_PUBLIC_URL=https://yourdomain.com

# ── JWT ───────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_CHAR_HEX
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_64_CHAR_HEX
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Email / SMTP ──────────────────────────────
# Options: Gmail, SendGrid, Postmark, Mailgun, AWS SES, Mailtrap (for testing)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@yourdomain.com

# ── Storage ───────────────────────────────────
# Use 'local' for VPS uploads or 's3' for AWS S3 / Cloudflare R2
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads

# AWS S3 / Cloudflare R2 (only needed if STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=me-central-1
AWS_BUCKET=uaejobs-uploads
# For Cloudflare R2, set the R2 endpoint:
# AWS_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# ── Billing ───────────────────────────────────
# Use 'mock' for testing or 'stripe' for real payments
BILLING_PROVIDER=mock
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── AI (Anthropic) ────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Rate limiting ─────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# ── Seed (used by prisma db seed) ─────────────
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
